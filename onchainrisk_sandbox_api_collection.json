{
  "info": {
    "_postman_id": "onchainrisk-sandbox-v1",
    "name": "OnChainRisk Sandbox API",
    "description": "Public sandbox tier — integration testing against real OnChainRisk API.\n\n**Setup (one-time, via dashboard — NOT via this collection):**\n1. Sign up at https://onchainrisk.io/register (CAPTCHA required)\n2. Dashboard → API Keys → Create sandbox key (1 max for free tier)\n3. Copy the key (shown once)\n4. In Postman: set env var `sandbox_api_key` to your key\n\nAll requests here use that key via `Authorization: Bearer {{sandbox_api_key}}`. Key management (create/rotate/revoke) lives in the dashboard — not exposed to sandbox because the self-service flow is intentional.\n\n**Sandbox gates expensive fields** — responses match paid shape but `crossChain`, `tokenFlow`, `clusters`, `honeypot`, etc. are always `null`/`[]`. See `_sandbox.gated_fields[]` in every response for the authoritative list.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.onchainrisk.io",
      "type": "string"
    },
    {
      "key": "sandbox_api_key",
      "value": "ocr_test_REPLACE_ME",
      "type": "string",
      "description": "Your sandbox API key. New sandbox keys use the ocr_test_ prefix; legacy sandbox keys may still carry ocr_live_ and continue to authenticate as sandbox. Create one in the dashboard: https://onchainrisk.io/dashboard/api-keys"
    },
    {
      "key": "sample_address",
      "value": "0xa39b189482f984388a34460636fea9eb181ad1a6",
      "type": "string",
      "description": "Light demo address — runs fast. Swap to your own for real integration testing."
    }
  ],
  "item": [
    {
      "name": "1. Check address — POST /api/v1/check",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sandbox_api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address\": \"{{sample_address}}\",\n  \"network\": \"eth\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/check",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "check"
          ]
        },
        "description": "Sandbox risk analysis for one address. The response carries a `_sandbox` block and gates the paid-only sections (`crossChain`, `tokenFlow`, `clusters`) to null. Validation failures return 422 with `error.code = VALIDATION_ERROR` — the stored examples below show each granular `details.errorCode`."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('_sandbox block present', () => pm.expect(d._sandbox).to.be.an('object'));",
              "pm.test('_sandbox.profile = sandbox', () => pm.expect(d._sandbox.profile).to.equal('sandbox'));",
              "pm.test('_sandbox.reports_saved = false', () => pm.expect(d._sandbox.reports_saved).to.equal(false));",
              "pm.test('gated: crossChain is null', () => pm.expect(d.crossChain).to.equal(null));",
              "pm.test('gated: tokenFlow is null', () => pm.expect(d.tokenFlow).to.equal(null));",
              "pm.test('gated: clusters is null', () => pm.expect(d.clusters).to.equal(null));",
              "pm.test('gated: topCounterparties is []', () => pm.expect(d.topCounterparties).to.eql([]));",
              "pm.test('no reportId (sandbox does not persist)', () => pm.expect(d).to.not.have.property('reportId'));",
              "pm.test('no analysisMode (omitted by policy)', () => pm.expect(d).to.not.have.property('analysisMode'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Stable validation envelope: validation errors always 422 with",
              "// success:false + error.code=VALIDATION_ERROR + details.errorCode.",
              "// Added 2026-04-24 after the Tron/network mismatch incident.",
              "// (Ref: docs/testing/fixtures/validation/*.json — same shape.)",
              "pm.test('validation envelope is stable (422)', function () {",
              "    if (pm.response.code !== 422) return;",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('success', false);",
              "    pm.expect(body.error).to.have.property('code', 'VALIDATION_ERROR');",
              "    pm.expect(body.error).to.have.property('message');",
              "    pm.expect(body.error).to.have.property('details');",
              "    pm.expect(body.error.details).to.have.property('errorCode');",
              "});"
            ]
          }
        }
      ],
      "response": [
